# ==========================================================
# META Adhya Tirta Umbulan — Environment Configuration
# ==========================================================
# PERHATIAN KEAMANAN DEPLOYMENT PRODUKSI:
# 1. Pastikan APP_ENV=production dan APP_DEBUG=false untuk mencegah kebocoran stack trace/kredensial.
# 2. Selalu jalankan `php artisan key:generate` untuk menghasilkan APP_KEY yang kuat.
# 3. Ganti kredensial database (DB_USERNAME & DB_PASSWORD). JANGAN gunakan root tanpa password!
# 4. Berikan nilai rahasia acak yang kuat pada WHATSAPP_SECRET_TOKEN untuk autentikasi microservice.
# ==========================================================

APP_NAME="META ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=umbulan_erp
DB_USERNAME=erp_user
DB_PASSWORD=your_strong_db_password_here

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@umbulan.co.id"
MAIL_FROM_NAME="${APP_NAME}"

# Integrasi WhatsApp Microservice (Baileys)
WHATSAPP_SERVICE_URL=http://127.0.0.1:3001
WHATSAPP_SECRET_TOKEN=change_me_to_a_secure_random_token_32chars

VITE_APP_NAME="${APP_NAME}"
