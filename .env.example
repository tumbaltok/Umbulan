# ==========================================================
# META Adhya Tirta Umbulan — Environment Configuration
# ==========================================================

APP_NAME="META Adhya Tirta Umbulan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Domain Utama & Subdomain Karyawan
APP_MAIN_DOMAIN=localhost
# SESSION_DOMAIN=.umbulan.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==========================================================
# DATABASE
# ==========================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=umbulan
DB_USERNAME=root
DB_PASSWORD=

# ==========================================================
# SESSION, CACHE & QUEUE
# Catatan: Driver session menggunakan 'file' karena tabel sessions database tidak digunakan.
# ==========================================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# ==========================================================
# PENGIRIMAN EMAIL & OTP (SMTP)
# ==========================================================
# Pilihan MAIL_MAILER:
# - 'smtp' : Mengirim email asli ke inbox pengguna
# - 'log'  : Mode pengujian (email hanya dicatat di storage/logs/laravel.log)
#
# Panduan Port & Scheme (Symfony Mailer):
# - Port 587 (Rekomendasi untuk Gmail / STARTTLS) : MAIL_SCHEME=null
# - Port 465 (SSL / SMTPS)                         : MAIL_SCHEME=smtps
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_FROM_ADDRESS="no-reply@umbulan.co.id"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================================
# WHATSAPP GATEWAY MICROSERVICE (BAILEYS)
# Microservice Node.js di folder /whatsapp-service (Port 3001)
# ==========================================================
WHATSAPP_SERVICE_URL=http://127.0.0.1:3001
WHATSAPP_SECRET_TOKEN=umbulan_internal_wa_secret_key_2026

# ==========================================================
# FRONTEND / ASSET VITE
# ==========================================================
VITE_APP_NAME="${APP_NAME}"
